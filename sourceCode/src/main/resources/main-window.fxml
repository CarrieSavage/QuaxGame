<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="quax.QuaxController">
    <top>
        <VBox alignment="CENTER" spacing="10" style="-fx-background-color: #15616D; -fx-padding: 10;">
            <Text fill="FFECD1" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Quax (Bot V Human)" />
            <HBox alignment="CENTER" spacing="20">
                <Button onAction="#onNewGame" text="New Game" />
                <Button onAction="#onExitGame" text="Exit Game" />
            </HBox>
        </VBox>
    </top>

    <center>
        <StackPane fx:id="boardContainer" />
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="20" style="-fx-padding: 10;">
         <Polygon fx:id="labelPolygon" fill="DODGERBLUE" stroke="BLACK" strokeType="INSIDE">
           <points>
               <Double fx:value="-10.71" />
               <Double fx:value="20.0" />

               <Double fx:value="10.71" />
               <Double fx:value="20.0" />

               <Double fx:value="20.0" />
               <Double fx:value="10.71" />

               <Double fx:value="20.0" />
               <Double fx:value="-10.71" />

               <Double fx:value="10.71" />
               <Double fx:value="-20.0" />

               <Double fx:value="-10.71" />
               <Double fx:value="-20.0" />

               <Double fx:value="-20.0" />
               <Double fx:value="-10.71" />

               <Double fx:value="-20.0" />
               <Double fx:value="10.71" />
           </points>
         </Polygon>
            <Label fx:id="statusLabel" style="-fx-font-size: 16px;" text="WHITE to play" />
         <Rectangle fx:id="labelRhombus" fill="DODGERBLUE" height="15.0" rotate="45" stroke="BLACK" strokeType="INSIDE" width="15.0" />
         <Button fx:id="pieRuleButton" onAction="#onActivatePieRule" mnemonicParsing="false" text="Activate Pie Rule" />
         <Button fx:id="strategyButton" onAction="#onToggleStrategy" mnemonicParsing="false" text="Show Strategy" />
        </HBox>
    </bottom>
</BorderPane>
